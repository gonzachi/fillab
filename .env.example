# Copiar a .env.local y completar. Sin estas variables, /dashboard corre
# en modo demo automáticamente (ver docs/dashboard-setup.md) — no hace
# falta nada de esto para trabajar en el sitio público.

# ── Supabase (auth + tabla de mapeo cliente → sitio) ─────────────────────
# Nombres con el prefijo FILLAB_ porque el proyecto se creó desde el
# Marketplace de Vercel (Storage tab) — Vercel prefija los recursos con su
# nombre para no chocar si hay más de uno. Si en cambio creaste el
# proyecto directo en supabase.com, estas variables se llaman
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY — ajustá
# src/lib/dashboard/config.ts y src/lib/supabase/*.ts si es tu caso.
NEXT_PUBLIC_FILLAB_SUPABASE_URL=
NEXT_PUBLIC_FILLAB_SUPABASE_PUBLISHABLE_KEY=

# ── Umami (self-hosted) ───────────────────────────────────────────────
# URL de tu instancia, sin barra final. Ej: https://umami-tuyo.vercel.app
UMAMI_API_URL=
UMAMI_USERNAME=
UMAMI_PASSWORD=

# Website ID de fillab.io dentro de Umami (Settings → Websites). Pública
# a propósito: la usa el script de tracking en el navegador. Sin esto,
# el sitio no manda ningún evento — ver (marketing)/layout.tsx.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
